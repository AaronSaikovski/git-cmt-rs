#!/usr/bin/env bash
#
# Thin wrapper that points git-cmt-rs at LM Studio.
#
# Install with:
#   sudo install -m 755 scripts/git-cmt /usr/local/bin/git-cmt
#
# Every argument is forwarded to git-cmt-rs, so `git-cmt -a`, `git-cmt -v`
# and `git-cmt -h` behave exactly like the bare binary.

set -euo pipefail

# Defaults apply when a variable is unset or empty; nonempty overrides win.
export OPENAI_BASE_URL="${OPENAI_BASE_URL:-http://localhost:1235/v1}"
export OPENAI_MODEL="${OPENAI_MODEL:-google/gemma-4-12b}"
export OPENAI_RESPONSE_FORMAT="${OPENAI_RESPONSE_FORMAT:-none}"

# `exec` hands the process over, so git-cmt-rs's exit code is this script's.
# "$@" (quoted) forwards each argument intact; $* or unquoted $@ would re-split
# on whitespace.
exec "${GIT_CMT_RS_BIN:-git-cmt-rs}" "$@"
